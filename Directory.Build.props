<Project>

  <!--
    The engine is consumed as a package by the games built on it, so every project
    shares one version and one output folder: `dotnet pack` drops the three
    packable assemblies into `packages/`, which is the local feed a game's
    nuget.config points at.

    Only Fornach.Domain, Fornach.Engine and Fornach.Spatial set IsPackable=true.
    Tests and anything else that is not part of the engine's surface stay
    unpackable by default.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Fornach</Authors>
    <Product>Fornach</Product>
    <PackageOutputPath>$(MSBuildThisFileDirectory)packages</PackageOutputPath>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <!-- Names the file the ItemGroup below packs; inert in unpackable projects. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    A game reads these packages, not this repo, so the README has to travel with
    them. Included by path from the repo root because the projects sit two levels
    down. Keyed on the file rather than IsPackable: this file is evaluated before
    the project body, so IsPackable is still its default false here, and a None
    item is inert in projects that never pack.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
