<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fornach.Spatial</PackageId>
    <Description>Grid geometry for Fornach: points, directions, flanking, field of view and pathfinding.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Point.fs" />
    <Compile Include="Direction.fs" />
    <Compile Include="Flanking.fs" />
    <Compile Include="Distance.fs" />
    <Compile Include="Line.fs" />
    <Compile Include="Los.fs" />
    <Compile Include="VisionCone.fs" />
    <Compile Include="Fov.fs" />
    <Compile Include="Pathfinding.fs" />
    <Compile Include="Dijkstra.fs" />
  </ItemGroup>

</Project>
