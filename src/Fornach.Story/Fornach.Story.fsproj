<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="StoryTypes.fs" />
    <Compile Include="Bosses.fs" />
    <Compile Include="StoryRunner.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Qyl27.Ink.Engine" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fornach.Domain\Fornach.Domain.fsproj" />
    <ProjectReference Include="..\Fornach.Engine\Fornach.Engine.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Scripts\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Scripts\prologue.ink.json" />
  </ItemGroup>
</Project>
