<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Fornach.Engine</PackageId>
    <Description>The Fornach combat engine: actions, resolution, AI, world events, the tower session and the balance harness.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RuntimeLog.fs" />
    <Compile Include="DicePool.fs" />
    <Compile Include="Actions.fs" />
    <Compile Include="IndesResolver.fs" />
    <Compile Include="ActionResolver.fs" />
    <Compile Include="AttackEstimator.fs" />
    <Compile Include="CombatLogger.fs" />
    <Compile Include="AI.fs" />
    <Compile Include="WorldEvents.fs" />
    <Compile Include="TowerGenerator.fs" />
    <Compile Include="TowerSession.fs" />
    <Compile Include="CombatSimulation.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fornach.Domain\Fornach.Domain.fsproj" />
  </ItemGroup>

</Project>
